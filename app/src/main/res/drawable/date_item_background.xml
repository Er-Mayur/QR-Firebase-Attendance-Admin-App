<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4D000000" /> <!-- Semi-transparent black color for shadow -->
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Actual item background -->
    <item android:right="2dp" android:left="2dp" android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" /> <!-- White color for the item -->
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
